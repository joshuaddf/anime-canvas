---
import "../styles/globals.css";
import "../script/Anime.js";
import "../script/Lenis.js";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/images/img4.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content=" A quiet, brief acknowledgement of photography. A personal creation, inspired by some photographs taken in 2024."
    />
      <link 
      rel="preload" 
      href="/font/InstrumentSerif-Regular.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <link 
      rel="preload" 
      href="/font/Helvetica.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <title>Faint note</title>
  </head>
  <body>
    <!-- <section class="intro">
      <h1>hi</h1>
    </section> -->
    <button class="btn" type="button" aria-expanded="false" aria-controls="info-panel" aria-label="Open information">
      <div class="btn-slider">
        <div class="el">
          <span class="">Info</span>
        </div>
        <div class="el">
          <span class="">Close</span>
        </div>
      </div>
    </button>

    <aside id="info-panel" class="header-container" aria-hidden="true">
      <p class="header-text">
        A quiet, brief acknowledgement of photography. A personal creation,
        inspired by some photographs taken in 2024. (Not the best photos, but...)
      </p>
    </aside>

    <button class="overlay" type="button" aria-label="Close information"></button>

    <slot />
  </body>
</html>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.2);
    pointer-events: none;
    opacity: 0;
    border: 0;
    padding: 0;
    cursor: default;
    z-index: 8;
  }

  .overlay.is-active {
    pointer-events: auto;
    cursor: pointer;
  }

  .header-container {
    position: fixed;
    top: 0;
    right: 0;
    width: min(34rem, 42vw);
    height: 100dvh;
    background-color: #f7f5f2;
    z-index: 9;
    display: flex;
    align-items: center;
    justify-content: start;
    container-type: inline-size;
    transform: translateX(100%);
  }

  .header-container.is-open {
    transform: translateX(0);
  }

  .header-text {
    font-family: "Helvetica", sans-serif;
    font-size: 16px;
    font-weight: 600;
    text-align: left;
    max-width: 50ch;
    padding: 2rem;
    line-height: 1.1;
    color: #4a4a4a;
  }

  section {
    width: 100%;
    height: 100vh;
    background-color: red;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn {
    position: fixed;
    z-index: 20;
    top: 2rem;
    right: 2rem;
    width: 50px;
    height: 25px;
    /* background-color: red; */
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: "Helvetica", sans-serif;
    font-size: clamp(1rem, 1.1vw, 1.5rem);
    overflow: hidden;
    border: 0;
    padding: 0;
    background: transparent;
    color: #fff;
    mix-blend-mode: difference;
  }

  .btn-slider {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .el {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;

    &:nth-child(2) {
      position: absolute;
      top: 100%;
    }
  }

  @media (max-width: 768px) {
    .header-container {
      top: auto;
      bottom: 0;
      left: 0;
      width: 100%;
      height: auto;
      min-height: 42dvh;
      transform: translateY(100%);
      align-items: flex-start;
    }

    .header-container.is-open {
      transform: translateY(0);
    }

    .header-text {
      padding: 4rem 1.5rem 2.5rem;
    }
  }
</style>

<script>
  import { setupAnimations } from "../script/Anime";
  import { setupLenis } from "../script/Lenis";
  setupLenis();
  setupAnimations();
</script>
