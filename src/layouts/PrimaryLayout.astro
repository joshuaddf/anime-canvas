---
import "../styles/globals.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content=" A quiet, brief acknowledgement of photography. A personal creation, inspired by some photographs taken in 2024."
    />
      <link 
      rel="preload" 
      href="/font/InstrumentSerif-Regular.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <link 
      rel="preload" 
      href="/font/Helvetica.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <title>Faint note</title>
  </head>
  <body>
    <!-- <section class="intro">
      <h1>hi</h1>
    </section> -->
    <button
      class="btn"
      type="button"
      aria-label="Open information panel"
      aria-expanded="false"
      aria-controls="info-panel"
    >
      <span class="btn-slider" aria-hidden="true">
        <span class="el">
          <span>Info</span>
        </span>
        <span class="el">
          <span>Close</span>
        </span>
      </span>
    </button>

    <aside class="header-container" id="info-panel" aria-hidden="true">
      <p class="header-text">
        Faint Note is a quiet acknowledgement of photography — a personal essay
        assembled from photographs made in Accra during 2024. It is less about
        perfect pictures than the practice of noticing what nearly passed unseen.
      </p>
    </aside>

    <button class="overlay" type="button" aria-label="Close information panel"></button>

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(12, 11, 10, 0.36);
    pointer-events: none;
    opacity: 0;
    border: 0;
    padding: 0;
    cursor: default;
    z-index: 8;
  }

  .overlay.is-active {
    pointer-events: auto;
    cursor: pointer;
  }

  .header-container {
    position: fixed;
    top: 0;
    right: 0;
    width: min(34rem, 42vw);
    height: 100dvh;
    overflow: hidden;
    background-color: #f3f0ea;
    z-index: 9;
    display: flex;
    align-items: center;
    transform: translateX(100%);
    transition: transform 900ms cubic-bezier(0.19, 1, 0.22, 1);
  }

  .header-container.is-open {
    transform: translateX(0);
  }

  .header-text {
    font-family: "Helvetica", sans-serif;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 400;
    text-align: left;
    max-width: 50ch;
    padding: clamp(2rem, 5vw, 5rem);
    line-height: 1.25;
    color: #4a4a4a;
  }

  main {
    width: 100%;
  }

  .btn {
    position: fixed;
    z-index: 99;
    top: 1.8rem;
    right: clamp(1.25rem, 3vw, 3rem);
    width: 50px;
    height: 25px;
    /* background-color: red; */
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: "Helvetica", sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    overflow: hidden;
    padding: 0;
    border: 0;
    color: #fff;
    background: transparent;
    mix-blend-mode: difference;
  }

  .btn-slider {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .el {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;

    &:nth-child(2) {
      position: absolute;
      top: 100%;
    }
  }

  @media (max-width: 768px) {
    .header-container {
      top: auto;
      bottom: 0;
      width: 100%;
      height: auto;
      min-height: 46dvh;
      transform: translateY(100%);
    }

    .header-container.is-open {
      transform: translateY(0);
    }

    .header-text {
      padding: 4rem 1.5rem 2.5rem;
    }
    .btn {
      top: 1rem;
    }
  }
</style>

<script>
  import { setupAnimations } from "../script/Anime";
  import { setupLenis } from "../script/Lenis";
  setupLenis();
  setupAnimations();
</script>
