---
import "../styles/globals.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content=" A quiet, brief acknowledgement of photography. A personal creation, inspired by some photographs taken in 2024."
    />
      <link 
      rel="preload" 
      href="/font/InstrumentSerif-Regular.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <link 
      rel="preload" 
      href="/font/Helvetica.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <title>Faint note</title>
  </head>
  <body>
    <!-- <section class="intro">
      <h1>hi</h1>
    </section> -->
    <button
      class="btn"
      type="button"
      aria-label="Open information panel"
      aria-expanded="false"
      aria-controls="info-panel"
    >
      <span class="btn-slider" aria-hidden="true">
        <span class="el">
          <span>Info</span>
        </span>
        <span class="el">
          <span>Close</span>
        </span>
      </span>
    </button>

    <aside class="header-container" id="info-panel" aria-hidden="true">
      <p class="header-text">
        A quiet, brief acknowledgement of photography. A personal creation,
        inspired by some photographs taken in 2024. (Not the best photos, but...)
      </p>
    </aside>

    <button class="overlay" type="button" aria-label="Close information panel"></button>

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.2);
    pointer-events: none;
    opacity: 0;
    border: 0;
    z-index: 8;
  }

  .overlay.is-active {
    pointer-events: auto;
  }

  .header-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 0;
    overflow: hidden;
    background-color: #f7f5f2;
    z-index: 9;
    display: flex;
    align-items: center;
    justify-content: start;
    container-type: inline-size;
  }

  .header-text {
    font-family: "Helvetica", sans-serif;
    font-size: 16px;
    font-weight: 600;
    text-align: left;
    max-width: 50ch;
    padding: 2rem;
    line-height: 1.1;
    color: #4a4a4a;
  }

  main {
    width: 100%;
  }

  .btn {
    position: fixed;
    z-index: 99;
    top: 2rem;
    right: 2rem;
    width: 50px;
    height: 25px;
    /* background-color: red; */
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: "Helvetica", sans-serif;
    font-size: clamp(1rem, 1.1vw, 1.5rem);
    overflow: hidden;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
  }

  .btn-slider {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .el {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;

    &:nth-child(2) {
      position: absolute;
      top: 100%;
    }
  }
</style>

<script>
  import { setupAnimations } from "../script/Anime";
  import { setupLenis } from "../script/Lenis";
  setupLenis();
  setupAnimations();
</script>
